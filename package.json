{
	"name": "@surrealdb/vercel-ai",
	"version": "0.1.0",
	"description": "Vercel AI SDK integration for Spectron — SurrealDB's agent memory layer. Middleware and tools that give generateText / streamText long-term memory.",
	"homepage": "https://surrealdb.com/platform/spectron",
	"repository": {
		"type": "git",
		"url": "https://github.com/surrealdb-dev/spectron-vercel-ai-sdk.git"
	},
	"license": "Apache-2.0",
	"type": "module",
	"keywords": [
		"spectron",
		"surrealdb",
		"vercel",
		"ai-sdk",
		"ai",
		"memory",
		"middleware",
		"rag"
	],
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"bun": ">=1.0.0",
		"node": ">=22"
	},
	"workspaces": [
		"examples/*"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"typecheck:examples": "tsc --noEmit -p examples/basic/tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@surrealdb/spectron": "^1.0.0-alpha.5"
	},
	"peerDependencies": {
		"ai": "^7.0.0",
		"typescript": "^5.0.0 || ^6.0.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@types/node": "^22.0.0",
		"ai": "^7.0.19",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^3.1.3"
	},
	"packageManager": "bun@1.2.21"
}
